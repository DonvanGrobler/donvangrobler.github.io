    color: #031019;
  }

  .button:hover { background: #a6ecff; }
  .button.ghost {
    border-color: rgba(177, 226, 244, .28);
    background: rgba(5, 18, 30, .46);
    color: #edf9ff;
    backdrop-filter: blur(10px);
  }

  .button.ghost:hover { background: rgba(18, 48, 68, .72); }

  .journey-progress {
    position: absolute;
    z-index: 12;
    right: 1.5rem;
    top: 50%;
    display: grid;
    gap: .8rem;
    transform: translateY(-50%);
  }

  .progress-dot {
    width: 7px;
    height: 7px;
    border: 1px solid rgba(175, 226, 244, .42);
    border-radius: 50%;
    background: transparent;
    transition: background 240ms ease, box-shadow 240ms ease, transform 240ms ease;
  }

  .orbital-journey[data-stage='0'] [data-dot='0'],
  .orbital-journey[data-stage='1'] [data-dot='1'],
  .orbital-journey[data-stage='2'] [data-dot='2'],
  .orbital-journey[data-stage='3'] [data-dot='3'] {
    background: #77ddff;
    box-shadow: 0 0 14px #77ddff;
    transform: scale(1.35);
  }

  .scroll-cue {
    position: absolute;
    z-index: 12;
    left: 50%;
    bottom: 1.5rem;
    display: grid;
    justify-items: center;
    gap: .5rem;
    opacity: var(--scroll-opacity);
    transform: translateX(-50%);
    color: rgba(220, 244, 252, .62);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: .65rem;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .scroll-cue i {
    position: relative;
    width: 22px;
    height: 36px;
    border: 1px solid rgba(220, 244, 252, .35);
    border-radius: 999px;
  }

  .scroll-cue i::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 7px;
    width: 3px;
    height: 7px;
    border-radius: 999px;
    background: #8bdfff;
    transform: translateX(-50%);
    animation: scroll-pulse 1.8s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%, 100% { opacity: .3; transform: translate(-50%, 0); }
    50% { opacity: 1; transform: translate(-50%, 12px); }
  }

  @media (max-width: 900px) {
    .orbital-journey {
      height: auto;
      --satellite-opacity: 1;
      --satellite-x: 0px;
      --satellite-y: 0px;
      --satellite-scale: .86;
      --earth-y: 0px;
      --earth-opacity: 1;
      --stars-opacity: .92;
      --atmosphere-opacity: 0;
      --launch-opacity: 0;
      --rocket-opacity: 0;
      --orbit-opacity: .75;
      --label-opacity: 0;
    }

    .journey-sticky {
      position: relative;
      height: auto;
      min-height: 0;
      padding-bottom: 3rem;
      background:
        radial-gradient(circle at 70% 22%, rgba(55, 155, 215, .18), transparent 22rem),
        #020711;
    }

    .journey-stage {
      position: relative;
      height: min(68vh, 560px);
      min-height: 430px;
    }

    .earth-horizon { bottom: -44vh; width: 180vw; }
    .orbiting-satellite { right: 50%; top: 23%; width: min(580px, 92vw); transform: translateX(50%) scale(.82) rotate(-4deg); }
    .orbit-line { right: -30%; width: 150vw; }
    .trajectory-line,
    .telemetry,
    .journey-progress,
    .scroll-cue { display: none; }

    .journey-content {
      height: auto;
      align-items: stretch;
      margin-top: -4.5rem;
    }

    .journey-copy {
      width: 100%;
      min-height: 0;
      display: grid;
      gap: 1rem;
    }

    .story-panel {
      position: relative;
      inset: auto;
      padding: 1.5rem;
      border: 1px solid rgba(151, 217, 244, .14);
      border-radius: 20px;
      opacity: 1 !important;
      pointer-events: auto;
      transform: none !important;
      background: linear-gradient(145deg, rgba(10, 31, 48, .82), rgba(4, 15, 27, .66));
      box-shadow: 0 18px 55px rgba(0,0,0,.24);
      backdrop-filter: blur(12px);
    }

    .story-panel h1 { font-size: clamp(2.8rem, 12vw, 4.7rem); }
    .story-panel h2 { font-size: clamp(2rem, 9vw, 3.5rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbital-journey {
      height: auto;
      --satellite-opacity: 1;
      --satellite-x: 0px;
      --satellite-y: 0px;
      --satellite-scale: .9;
      --earth-y: 0px;
      --earth-opacity: 1;
      --stars-opacity: .9;
      --atmosphere-opacity: 0;
      --launch-opacity: 0;
      --rocket-opacity: 0;
      --orbit-opacity: .72;
      --label-opacity: .8;
    }

    .journey-sticky {
      position: relative;
      height: auto;
      min-height: 0;
      padding: 4rem 0;
      background: #020711;
    }

    .journey-stage { position: absolute; height: 620px; }
    .journey-content { height: auto; }
    .journey-copy { min-height: 0; display: grid; gap: 1rem; }
    .story-panel { position: relative; inset: auto; opacity: 1 !important; transform: none !important; pointer-events: auto; padding: 1.5rem; background: rgba(3, 13, 24, .78); border-radius: 18px; }
    .scroll-cue, .journey-progress { display: none; }
    .scroll-cue i::after { animation: none; }
  }
</style>

<script is:inline>
  (() => {
    const journey = document.querySelector('[data-orbital-journey]');
    if (!journey) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const mobile = window.matchMedia('(max-width: 900px)');
    const altitude = journey.querySelector('[data-altitude]');
    let frameRequested = false;

    const clamp = (value, min = 0, max = 1) => Math.min(max, Math.max(min, value));
    const smooth = (value) => {
      const x = clamp(value);
      return x * x * (3 - 2 * x);
    };

    const render = () => {
      frameRequested = false;
      if (reducedMotion.matches || mobile.matches) return;

      const rect = journey.getBoundingClientRect();
      const scrollable = Math.max(1, journey.offsetHeight - window.innerHeight);
      const progress = clamp(-rect.top / scrollable);
      const stage = progress < .22 ? 0 : progress < .48 ? 1 : progress < .74 ? 2 : 3;

      journey.dataset.stage = String(stage);

      const launch = smooth((progress - .025) / .59);
      const orbital = smooth((progress - .48) / .36);
      const stars = clamp(.16 + progress * 1.38);
      const earth = smooth((progress - .25) / .52);
      const atmosphere = 1 - smooth((progress - .08) / .5);
      const launchSite = 1 - smooth((progress - .05) / .31);
      const plume = 1 - smooth((progress - .42) / .22);
      const rocketFade = 1 - smooth((progress - .5) / .13);
      const viewportH = window.innerHeight;
      const viewportW = window.innerWidth;

      journey.style.setProperty('--rocket-y', `${-launch * viewportH * 1.16}px`);
      journey.style.setProperty('--rocket-x', `${launch * launch * viewportW * .085}px`);
      journey.style.setProperty('--rocket-scale', `${1 - launch * .22}`);
      journey.style.setProperty('--rocket-rotate', `${launch * 4.5}deg`);
      journey.style.setProperty('--rocket-opacity', `${rocketFade}`);
      journey.style.setProperty('--plume-opacity', `${Math.max(.08, plume)}`);
      journey.style.setProperty('--satellite-opacity', `${orbital}`);
      journey.style.setProperty('--satellite-x', `${(1 - orbital) * 90}px`);
      journey.style.setProperty('--satellite-y', `${(1 - orbital) * 48}px`);
      journey.style.setProperty('--satellite-scale', `${.76 + orbital * .24}`);
      journey.style.setProperty('--earth-y', `${(1 - earth) * 38}vh`);
      journey.style.setProperty('--earth-opacity', `${earth}`);
      journey.style.setProperty('--stars-opacity', `${stars}`);
      journey.style.setProperty('--atmosphere-opacity', `${atmosphere}`);
      journey.style.setProperty('--cloud-y', `${progress * viewportH * .44}px`);
      journey.style.setProperty('--launch-opacity', `${launchSite}`);
      journey.style.setProperty('--orbit-opacity', `${orbital * .92}`);
      journey.style.setProperty('--label-opacity', `${smooth((progress - .75) / .2)}`);
      journey.style.setProperty('--scroll-opacity', `${1 - smooth(progress / .09)}`);
      journey.style.setProperty('--aura-opacity', `${Math.max(.02, plume * .48)}`);
      journey.style.setProperty('--telemetry-opacity', `${.18 + orbital * .82}`);

      if (altitude) altitude.textContent = `${String(Math.round(progress * 620)).padStart(3, '0')} km`;
    };

    const requestRender = () => {
      if (frameRequested) return;
      frameRequested = true;
      requestAnimationFrame(render);
    };

    window.addEventListener('scroll', requestRender, { passive: true });
    window.addEventListener('resize', requestRender, { passive: true });
    reducedMotion.addEventListener?.('change', requestRender);
    mobile.addEventListener?.('change', requestRender);
    render();
  })();
</script>