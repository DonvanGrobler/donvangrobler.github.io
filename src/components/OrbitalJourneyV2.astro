  .orbital-journey[data-stage='0'] [data-story='0'],.orbital-journey[data-stage='1'] [data-story='1'],.orbital-journey[data-stage='2'] [data-story='2'],.orbital-journey[data-stage='3'] [data-story='3'],.orbital-journey[data-stage='4'] [data-story='4'] { opacity:1; pointer-events:auto; transform:translateY(-50%); }
  .story-panel h1 { max-width:820px; margin-bottom:1.15rem; font-size:clamp(3rem,6.1vw,5.9rem); color:#f3fbff; text-wrap:balance; }.story-panel h2 { max-width:620px; margin-bottom:1.1rem; font-size:clamp(2.35rem,4.65vw,4.45rem); color:#f3fbff; text-wrap:balance; }.story-panel p:not(.mission-code) { max-width:650px; margin-top:0; color:#a9c2d0; font-size:clamp(1rem,1.55vw,1.18rem); }.mission-code { margin:0 0 .85rem; color:#7bdcff; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.73rem; font-weight:650; letter-spacing:.18em; }
  .story-panel .button-row { margin-top:1.45rem; }.story-panel .button { border-color:#75d9fa; background:#69cfee; color:#031019; }.story-panel .button:hover { background:#a6ecff; }.story-panel .button.ghost { border-color:rgba(177,226,244,.28); background:rgba(5,18,30,.46); color:#edf9ff; backdrop-filter:blur(10px); }.story-panel .button.ghost:hover { background:rgba(18,48,68,.72); }

  .journey-progress { position:absolute; z-index:13; right:1.5rem; top:50%; display:grid; gap:.72rem; transform:translateY(-50%); }.journey-progress span { width:7px; height:7px; border:1px solid rgba(175,226,244,.42); border-radius:50%; transition:background 240ms ease,box-shadow 240ms ease,transform 240ms ease; }.orbital-journey[data-stage='0'] [data-dot='0'],.orbital-journey[data-stage='1'] [data-dot='1'],.orbital-journey[data-stage='2'] [data-dot='2'],.orbital-journey[data-stage='3'] [data-dot='3'],.orbital-journey[data-stage='4'] [data-dot='4'] { background:#77ddff; box-shadow:0 0 14px #77ddff; transform:scale(1.35); }
  .scroll-cue { position:absolute; z-index:13; left:50%; bottom:.7rem; display:grid; justify-items:center; gap:.35rem; opacity:var(--scroll-opacity); transform:translateX(-50%); color:rgba(220,244,252,.68); font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.63rem; letter-spacing:.13em; text-transform:uppercase; }.scroll-cue i { position:relative; width:20px; height:31px; border:1px solid rgba(220,244,252,.38); border-radius:999px; }.scroll-cue i::after { content:''; position:absolute; left:50%; top:6px; width:3px; height:6px; border-radius:999px; background:#8bdfff; transform:translateX(-50%); animation:scroll-pulse 1.8s ease-in-out infinite; }
  @keyframes scroll-pulse { 0%,100% { opacity:.3; transform:translate(-50%,0); } 50% { opacity:1; transform:translate(-50%,9px); } }

  @media (max-height:760px) and (min-width:901px) {
    .journey-sticky { min-height:540px; }.journey-copy { min-height:410px; }.story-panel { top:46%; }.story-panel h1 { font-size:clamp(2.8rem,5.7vw,4.8rem); margin-bottom:.85rem; }.story-panel h2 { font-size:clamp(2.15rem,4.3vw,3.8rem); }.story-panel p:not(.mission-code) { font-size:1rem; line-height:1.55; }.story-panel .button-row { margin-top:1rem; }.telemetry { top:4.2rem; }
  }

  @media (max-width:900px) {
    .orbital-journey { height:auto; --sat-opacity:1; --sat-x:0px; --sat-y:0px; --sat-scale:.82; --earth-y:0px; --earth-opacity:1; --stars-opacity:.92; --atmosphere-opacity:0; --launch-opacity:0; --orbit-opacity:.75; --label-opacity:0; --upper-opacity:0; --core-opacity:0; --booster-opacity:0; --fairing-opacity:0; }
    .journey-sticky { position:relative; height:auto; min-height:0; padding-bottom:3rem; background:radial-gradient(circle at 70% 22%,rgba(55,155,215,.18),transparent 22rem),#020711; }
    .journey-stage { position:relative; height:min(68vh,560px); min-height:430px; }.earth-horizon { bottom:-44vh; width:180vw; }.payload-satellite { left:50%; top:27%; width:min(580px,92vw); transform:translate(-50%,-50%) scale(.78) rotate(-4deg); }.launch-stack,.rocket-aura,.separation-flash,.cubesat { display:none; }.orbit-line { right:-30%; width:150vw; }.trajectory-line,.telemetry,.journey-progress,.scroll-cue { display:none; }
    .journey-content { height:auto; align-items:stretch; margin-top:-4.5rem; }.journey-copy { width:100%; min-height:0; display:grid; gap:1rem; }.story-panel { position:relative; inset:auto; padding:1.5rem; border:1px solid rgba(151,217,244,.14); border-radius:20px; opacity:1!important; pointer-events:auto; transform:none!important; background:linear-gradient(145deg,rgba(10,31,48,.82),rgba(4,15,27,.66)); box-shadow:0 18px 55px rgba(0,0,0,.24); backdrop-filter:blur(12px); }.story-panel h1 { font-size:clamp(2.8rem,12vw,4.7rem); }.story-panel h2 { font-size:clamp(2rem,9vw,3.5rem); }
  }

  @media (prefers-reduced-motion:reduce) {
    .orbital-journey { height:auto; --sat-opacity:1; --sat-x:0px; --sat-y:0px; --sat-scale:.86; --earth-y:0px; --earth-opacity:1; --stars-opacity:.9; --atmosphere-opacity:0; --launch-opacity:0; --orbit-opacity:.72; --label-opacity:.8; --upper-opacity:0; --core-opacity:0; --booster-opacity:0; --fairing-opacity:0; }
    .journey-sticky { position:relative; height:auto; min-height:0; padding:4rem 0; background:#020711; }.journey-stage { position:absolute; height:620px; }.journey-content { height:auto; }.journey-copy { min-height:0; display:grid; gap:1rem; }.story-panel { position:relative; inset:auto; opacity:1!important; transform:none!important; pointer-events:auto; padding:1.5rem; background:rgba(3,13,24,.78); border-radius:18px; }.scroll-cue,.journey-progress,.launch-stack,.rocket-aura,.separation-flash { display:none; }.scroll-cue i::after { animation:none; }
  }
</style>

<script is:inline>
  (() => {
    const journey = document.querySelector('[data-orbital-journey]');
    if (!journey) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const mobile = window.matchMedia('(max-width: 900px)');
    const altitude = journey.querySelector('[data-altitude]');
    const event = journey.querySelector('[data-event]');
    let queued = false;
    const clamp = (v, min = 0, max = 1) => Math.min(max, Math.max(min, v));
    const smooth = (v) => { const x = clamp(v); return x * x * (3 - 2 * x); };
    const pulse = (p, at, width) => clamp(1 - Math.abs(p - at) / width);

    const render = () => {
      queued = false;
      if (reduced.matches || mobile.matches) return;
      const rect = journey.getBoundingClientRect();
      const scrollable = Math.max(1, journey.offsetHeight - window.innerHeight);
      const p = clamp(-rect.top / scrollable);
      const stage = p < .15 ? 0 : p < .36 ? 1 : p < .57 ? 2 : p < .79 ? 3 : 4;
      journey.dataset.stage = String(stage);

      const h = window.innerHeight;
      const w = window.innerWidth;
      const lift = smooth((p - .025) / .42);
      const pitch = smooth((p - .34) / .31);
      const boosterSep = smooth((p - .31) / .1);
      const boosterFade = 1 - smooth((p - .42) / .12);
      const coreSep = smooth((p - .43) / .11);
      const coreFade = 1 - smooth((p - .55) / .12);
      const fairingSep = smooth((p - .57) / .11);
      const fairingFade = 1 - smooth((p - .69) / .1);
      const deploy = smooth((p - .67) / .23);
      const orbit = smooth((p - .81) / .16);
      const upperFade = 1 - smooth((p - .78) / .12);
      const earth = smooth((p - .22) / .58);
      const atmosphere = 1 - smooth((p - .07) / .48);
      const launchSite = 1 - smooth((p - .05) / .29);

      const vx = lift * lift * w * .045 + pitch * w * .045;
      const vy = -lift * h * .42 - pitch * h * .055;
      const vr = lift * 8 + pitch * 48;
      journey.style.setProperty('--vehicle-x', `${vx}px`);
      journey.style.setProperty('--vehicle-y', `${vy}px`);
      journey.style.setProperty('--vehicle-scale', `${1 - lift * .12 - pitch * .08}`);
      journey.style.setProperty('--vehicle-rotate', `${vr}deg`);

      journey.style.setProperty('--booster-left-x', `${-boosterSep * 118}px`);
      journey.style.setProperty('--booster-right-x', `${boosterSep * 118}px`);
      journey.style.setProperty('--booster-y', `${boosterSep * 165}px`);
      journey.style.setProperty('--booster-left-r', `${-boosterSep * 32}deg`);
      journey.style.setProperty('--booster-right-r', `${boosterSep * 32}deg`);
      journey.style.setProperty('--booster-opacity', `${boosterFade}`);

      journey.style.setProperty('--core-y', `${coreSep * 185}px`);
      journey.style.setProperty('--core-r', `${coreSep * 18}deg`);
      journey.style.setProperty('--core-opacity', `${coreFade}`);
      journey.style.setProperty('--upper-opacity', `${upperFade}`);

      journey.style.setProperty('--fairing-left-x', `${-fairingSep * 105}px`);
      journey.style.setProperty('--fairing-right-x', `${fairingSep * 105}px`);
      journey.style.setProperty('--fairing-y', `${fairingSep * 42}px`);
      journey.style.setProperty('--fairing-left-r', `${-fairingSep * 43}deg`);
      journey.style.setProperty('--fairing-right-r', `${fairingSep * 43}deg`);
      journey.style.setProperty('--fairing-opacity', `${fairingFade}`);

      journey.style.setProperty('--main-plume', `${Math.max(.05, 1 - smooth((p - .42) / .16))}`);
      journey.style.setProperty('--upper-plume', `${smooth((p - .41) / .08) * upperFade}`);
      journey.style.setProperty('--aura-opacity', `${Math.max(.02, (1 - smooth((p - .48) / .2)) * .48)}`);

      journey.style.setProperty('--sat-opacity', `${smooth((p - .62) / .09)}`);
      journey.style.setProperty('--sat-x', `${-deploy * w * .075}px`);
      journey.style.setProperty('--sat-y', `${-h * .095 + deploy * h * .21}px`);
      journey.style.setProperty('--sat-scale', `${.08 + deploy * .92}`);
      journey.style.setProperty('--sat-r', `${vr - deploy * (vr + 5)}deg`);

      journey.style.setProperty('--cube-opacity', `${smooth((p - .82) / .12) * .82}`);
      journey.style.setProperty('--cube-one-x', `${-w * .02 - orbit * w * .15}px`);
      journey.style.setProperty('--cube-one-y', `${h * .02 + orbit * h * .08}px`);
      journey.style.setProperty('--cube-two-x', `${w * .01 + orbit * w * .08}px`);
      journey.style.setProperty('--cube-two-y', `${h * .03 + orbit * h * .18}px`);

      journey.style.setProperty('--earth-y', `${(1 - earth) * 38}vh`);
      journey.style.setProperty('--earth-opacity', `${earth}`);
      journey.style.setProperty('--stars-opacity', `${clamp(.16 + p * 1.35)}`);
      journey.style.setProperty('--atmosphere-opacity', `${atmosphere}`);
      journey.style.setProperty('--cloud-y', `${p * h * .42}px`);
      journey.style.setProperty('--launch-opacity', `${launchSite}`);
      journey.style.setProperty('--orbit-opacity', `${orbit * .92}`);
      journey.style.setProperty('--label-opacity', `${smooth((p - .84) / .14)}`);
      journey.style.setProperty('--scroll-opacity', `${1 - smooth(p / .07)}`);
      journey.style.setProperty('--telemetry-opacity', `${.2 + smooth(p / .18) * .8}`);
      journey.style.setProperty('--boost-flash', `${pulse(p, .355, .025)}`);
      journey.style.setProperty('--core-flash', `${pulse(p, .49, .025)}`);
      journey.style.setProperty('--fairing-flash', `${pulse(p, .62, .025)}`);

      if (altitude) altitude.textContent = `${String(Math.round(p * 620)).padStart(3, '0')} km`;
      if (event) event.textContent = stage === 0 ? 'PRE-LAUNCH' : stage === 1 ? 'ASCENT' : stage === 2 ? (p < .46 ? 'BOOSTER SEP' : 'STAGE SEP') : stage === 3 ? (p < .68 ? 'FAIRING SEP' : 'PAYLOAD DEPLOY') : 'ORBIT INSERTION';
    };

    const requestRender = () => { if (queued) return; queued = true; requestAnimationFrame(render); };
    window.addEventListener('scroll', requestRender, { passive:true });
    window.addEventListener('resize', requestRender, { passive:true });
    reduced.addEventListener?.('change', requestRender);
    mobile.addEventListener?.('change', requestRender);
    render();
  })();
</script>
