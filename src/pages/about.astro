---
import BaseLayout from '../layouts/BaseLayout.astro';

const experience = [
  {
    period: '2025–Present',
    role: 'Programme Lead · Operational Earth Observation Services',
    text: 'Leading a portfolio of operational geospatial services, with responsibility for delivery, planning, risk, stakeholder communication, product direction and coordination across technical and commercial teams.',
  },
  {
    period: '2021–2025',
    role: 'Project Manager · Product-Oriented EO Lead',
    text: 'Managed multi-stakeholder Earth-observation initiatives and progressively moved into product strategy, technical concept ownership, proposal development and requirements translation.',
  },
  {
    period: '2017–2020',
    role: 'Geotechnical and Environmental Geoscience',
    text: 'Worked across field investigation, GIS, technical interpretation, client reporting and business-unit coordination before moving into Earth observation.',
  },
];

const skills = [
  'Earth observation products and services',
  'Technical programme and project leadership',
  'Product discovery, roadmaps and operationalisation',
  'Python and GIS/EO analysis',
  'STAC and cloud-native geospatial concepts',
  'AI-assisted prototyping and human–AI interaction',
  'Proposal writing and European partnerships',
  'Land-use and land-cover change',
];
---
<BaseLayout title="About — Donvan Grobler" description="Earth observation programme lead and geospatial product professional based in Innsbruck, Austria.">
  <header class="page-header about-header">
    <div class="container about-intro">
      <div>
        <p class="eyebrow">About</p>
        <h1>Technical enough to understand the system. Product-minded enough to question it.</h1>
      </div>
      <p class="lead">I am an Earth-observation programme lead based in Innsbruck, Austria. My work sits between users, geospatial science, engineering and delivery—turning complex capabilities into practical services and clearer product decisions.</p>
    </div>
  </header>

  <section class="section compact">
    <div class="container facts-grid">
      <article class="fact"><span>Base</span><strong>Innsbruck, Austria</strong></article>
      <article class="fact"><span>Field</span><strong>Earth observation & geospatial AI</strong></article>
      <article class="fact"><span>Focus</span><strong>Products, programmes & usable systems</strong></article>
      <article class="fact"><span>Languages</span><strong>English · Afrikaans · German</strong></article>
    </div>
  </section>

  <section class="section">
    <div class="container grid two about-grid">
      <div class="prose">
        <p class="eyebrow">Working style</p>
        <h2>Connecting disciplines without losing sight of the user.</h2>
        <p>I work comfortably across the boundaries that separate domain experts, data scientists, software engineers, institutional partners and end users. That bridge role helps teams translate needs into credible requirements, delivery plans and product directions.</p>
        <p>I remain close to implementation through GIS and EO analysis, Python-based prototyping and cloud-native geospatial concepts. My particular interest is where AI can reduce technical friction while preserving transparency, provenance and human judgement.</p>
        <div class="button-row">
          <a class="button" href="https://www.linkedin.com/in/donvan-grobler/" rel="me">LinkedIn</a>
          <a class="button secondary" href="https://github.com/DonvanGrobler" rel="me">GitHub</a>
        </div>
      </div>
      <aside class="card skill-card">
        <p class="eyebrow">Capabilities</p>
        <ul class="skill-list">
          {skills.map((skill) => <li>{skill}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <section class="section timeline-section">
    <div class="container">
      <p class="eyebrow">Experience</p>
      <h2>A career moving closer to the full EO value chain.</h2>
      <div class="timeline">
        {experience.map((item) => (
          <article class="timeline-item">
            <p class="meta">{item.period}</p>
            <div>
              <h3>{item.role}</h3>
              <p class="muted">{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid two">
      <article class="card education-card">
        <p class="eyebrow">Education</p>
        <h3>Master’s in Geography and Environmental Management</h3>
        <p class="muted">Completed with distinction while working full-time. Research focused on land-use and land-cover change around South African national parks.</p>
        <hr />
        <h3>B.Sc. Honours in Environmental Sciences</h3>
        <p class="muted">Specialisation in environmental geology, following a double major in Geography and Geology.</p>
      </article>
      <article class="card education-card">
        <p class="eyebrow">Professional perspective</p>
        <h3>Research-grounded, delivery-oriented.</h3>
        <p class="muted">My background combines environmental science, geospatial analysis, technical project delivery and product leadership. This allows me to move between strategic decisions and the practical constraints behind them.</p>
        <p class="muted">I have also presented Earth-observation and AI work in European professional and institutional settings.</p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .about-intro { display: grid; grid-template-columns: 1.2fr .8fr; gap: 4rem; align-items: end; }
  .about-intro .lead { margin-bottom: .8rem; }
  .facts-grid { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--surface); box-shadow: var(--shadow); }
  .fact { min-height: 125px; padding: 1.4rem; border-right: 1px solid var(--line); }
  .fact:last-child { border-right: 0; }
  .fact span { display: block; margin-bottom: .6rem; color: var(--accent); font-size: .76rem; font-weight: 750; letter-spacing: .12em; text-transform: uppercase; }
  .fact strong { display: block; line-height: 1.35; }
  .about-grid { align-items: start; gap: 3rem; }
  .skill-card { padding: 2rem; }
  .skill-list { display: grid; gap: 0; padding: 0; margin: 0; list-style: none; }
  .skill-list li { position: relative; padding: .85rem 0 .85rem 1.5rem; border-bottom: 1px solid var(--line); }
  .skill-list li::before { content: ''; position: absolute; left: 0; top: 1.45rem; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px color-mix(in srgb, var(--accent) 65%, transparent); }
  .skill-list li:last-child { border-bottom: 0; }
  .timeline-section { border-block: 1px solid var(--line); background: color-mix(in srgb, var(--surface) 55%, transparent); }
  .timeline { margin-top: 2rem; }
  .timeline-item { display: grid; grid-template-columns: 170px 1fr; gap: 2rem; padding: 2rem 0; border-top: 1px solid var(--line); }
  .timeline-item h3 { margin-bottom: .6rem; }
  .timeline-item p { max-width: 760px; }
  .education-card { padding: clamp(1.5rem, 4vw, 2.5rem); }
  .education-card hr { margin: 2rem 0; border: 0; border-top: 1px solid var(--line); }
  @media (max-width: 850px) { .about-intro, .facts-grid { grid-template-columns: 1fr 1fr; } .fact:nth-child(2) { border-right: 0; } .fact:nth-child(-n+2) { border-bottom: 1px solid var(--line); } }
  @media (max-width: 620px) { .about-intro, .facts-grid, .timeline-item { grid-template-columns: 1fr; } .fact { border-right: 0; border-bottom: 1px solid var(--line); } .fact:last-child { border-bottom: 0; } .timeline-item { gap: .25rem; } }
</style>