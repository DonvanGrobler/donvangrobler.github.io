---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HomeThemeOverrides from '../components/HomeThemeOverrides.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Donvan Grobler — Earth observation and geospatial AI',
  description = 'Writing and selected work by Donvan Grobler at the intersection of Earth observation, geospatial AI, product development and technical programme leadership.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const cloudflareWebAnalyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN?.trim();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#087fa7" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Donvan Grobler — Writing" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const storedTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme =
          storedTheme === 'dark' || (!storedTheme && prefersDark) ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <HomeThemeOverrides />
    <a class="skip-link" href="#content">Skip to content</a>
    <Header />
    <main id="content"><slot /></main>
    <Footer />
    {
      cloudflareWebAnalyticsToken && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cloudflareWebAnalyticsToken })}
        ></script>
      )
    }
  </body>
</html>
